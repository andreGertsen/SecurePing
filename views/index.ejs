        <h2>Sidst opdateret: 22:51 &nbsp;&nbsp; <span id="næsteOpdatering_ID">Næste opdatering om: </span></h2>

        <div id="trafficListContainer_ID">
            <table id="logTable">
                <thead>
                    <tr>
                        <th>Tid</th>
                        <th>IP</th>
                        <th>Type</th>
                        <th>URL</th>
                    </tr>
                </thead>
                <tbody>

                </tbody>
            </table>


<script>
    function insertRow(entry) {
    const tableBody = document.querySelector("#logTable tbody");

    const row = document.createElement("tr");
    row.innerHTML = `
        <td>${entry.timestamp}</td>
        <td>${entry.ip}</td>
        <td>${entry.method}</td>
        <td>${entry.url}</td>
    `;

    tableBody.appendChild(row);
}

async function fetchNewData() {
    try {
        const response = await fetch('/call-other-server');
        const json = await response.json();

        if (json.status === "success") {
            // json.data er array fra loadbalancer
            json.data.forEach(entry => insertRow(entry));
        }
    } catch (err) {
        console.error("Kunne ikke hente data:", err);
    }
}

// Hent nyt data hvert 2. sekund
setInterval(fetchNewData, 2000);

// Hent med det samme ved load
fetchNewData();

</script>


