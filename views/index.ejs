<!DOCTYPE html>
<html>
    <head>
        <title>SecurePing</title>
        <link rel="stylesheet" href="/css/style.css">
    </head>
    <body>
        <header>
            <div id="topNavBar_ID">
                <h1>SecurePing</h1>
            </div>
            <br>
        </header>
        <br>
        <div id="trafficListContainer_ID">
            <table id="logTable">
                <thead>
                    <tr>
                        <th>Tid</th>
                        <th>IP</th>
                        <th>Type</th>
                        <th>URL</th>
                        <th>Land</th>
                    </tr>
                </thead>
                <tbody>

                </tbody>
            </table>

            <button id="blokerIPButton_ID" style="float: left;">Bloker</button>
        </div>
        <div>
        <div id="nøgletalContainer_ID">
            <div>
                <span><b>Gennemsnit Roundtrip time</b></span>
                <br>
                <span id="genRTT_ID">ms</span>
            </div>
            <br>
            <div>
                <span><b>Gennemsnit Responstid</b></span>
                <br>
                <span id="genRes_ID">ms</span>
            </div>
        </div>
        <br>
        <div id="rateLimitKonfigContainer_ID">
            <span><b>Ændre rate limit</b></span>
            <br><br>
            <span>Antal forespørgsler pr. minut</span>
            <br>
            <input type="number" min="1" max="10000" id="rateLimit_ID"><button id="sætRateLimit_ID">Udfør</button>
        </div>
        <br>
        <div id="sendDriftsmiddelelseContainer_ID">
            <span><b>Send driftsmeddelelse</b></span>
            <textarea rows="3" id="beskedIndhold_ID"></textarea>
            <span>Telefon</span><input type="checkbox">
            <br><br>
            <button id="sendDriftsmeddelelser_ID">Send</button>
        </div>
        <script src="/js/script.js"></script>
    </body>
</html>