<script>
// Opdater message hvert minut
setInterval(async () => {
  try {
    const res = await fetch('/api/data');
    const data = await res.json();
    document.getElementById('message').textContent = data.message;
  } catch (err) {
    console.error('Fejl ved hentning af data:', err);
  }
}, 60000);

</script>