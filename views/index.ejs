<script>
    // RATE LIMIT FUNKTION //
    document.getElementById('sætRateLimit_ID').addEventListener('click', () => {
        const rate = document.getElementById('rateLimit_ID').value; // får tal fra input

        // tjekker om input er gyldigt
        if(rate <= 0 || isNaN(rate))
        {
            alert("Ugyldigt input");
        }
        // Post den nye rate limit til loadbalanceren
        fetch('https://understory.live/set-rate-limit', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ rate: parseInt(rate) })
        })

        .then(response => { // vent på response // 
            if (!response.ok) throw new Error('Fejl ved opdatering');
            return response.json();
        })
        .then(data => { 
            document.getElementById("rateLimitOpdateret_ID").style.display = "inline-block";
            alert('Rate limit opdateret: ' + data.rate);
        })
        .catch(err =>
        {
            console.error(err);
            alert('Noget gik galt');
            return;
        });
    });


// ---------------------------------------------------------------------------- //
// HIGHLIGHT IP ADRESSERNE

function highLightMistænkeligeIPer() {
    const rows = Array.from(document.querySelectorAll("#logTable tbody tr"));
    const counts = {};

    // 1. Tæl IP'er
    rows.forEach(row => {
        const ipCell = row.querySelector(".ip");  // ← korrekt kolonne
        if (!ipCell) return;
        const ip = ipCell.textContent.trim();
        counts[ip] = (counts[ip] || 0) + 1;
    });

    // 2. Find top 3
    const top3 = Object.entries(counts)
    .filter(([ip, count]) => count > 10)
        .sort((a, b) => b[1] - a[1])
        .slice(0, 3)
        .map(entry => entry[0]);

    // 3. Ryd gamle farver
    rows.forEach(row => {
        row.classList.remove("ip-top1", "ip-top2", "ip-top3");
    });

    // 4. Farv rækkerne
    rows.forEach(row => {
        const ipCell = row.querySelector(".ip");
        if (!ipCell) return;

        const ip = ipCell.textContent.trim();

        if (ip === top3[0]) row.classList.add("ip-top1");
        else if (ip === top3[1]) row.classList.add("ip-top2");
        else if (ip === top3[2]) row.classList.add("ip-top3");
    });
}

