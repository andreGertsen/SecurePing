        <h2>Sidst opdateret: 22:51 &nbsp;&nbsp; <span id="næsteOpdatering_ID">Næste opdatering om: </span></h2>

        <div id="trafficListContainer_ID">
            <table id="logTable">
                <thead>
                    <tr>
                        <th>Tid</th>
                        <th>IP</th>
                        <th>Type</th>
                        <th>URL</th>
                        <th>Land</th>
                    </tr>
                </thead>
                <tbody>

                </tbody>
            </table>


<script>
// Track hvilke logs vi allerede har tilføjet
const seenEntries = new Set();

// Array til at samle IP-adresser fra markeringer
let selectedIPs = [];

function insertRow(entry) {
    const tableBody = document.querySelector("#logTable tbody");

    const row = document.createElement("tr");
    row.innerHTML = `
    <td class="ts">${entry.timestamp}</td>
    <td class="ip">${entry.ip}</td>
    <td>${entry.method}</td>
    <td>${entry.url}</td>
    <td>${entry.country}</td>   <!-- NY KOLONNE -->
`;
    // Tilføj click-handler
    row.addEventListener("click", () => highlightSameIP(entry.ip));

    tableBody.appendChild(row);
}

function highlightSameIP(ip) {
    const rows = document.querySelectorAll("#logTable tbody tr");

    selectedIPs = ""; // nulstil hver gang man klikker en ny række

    rows.forEach(row => {
        row.classList.remove("highlight");

        const rowIP = row.querySelector(".ip")?.textContent;
        if (rowIP === ip) {
            row.classList.add("highlight");
        }
        selectedIPs = rowIP; // sæt IP der skal blokkeres
    });

    console.log("Valgte IP'er:", selectedIPs);
}


async function fetchNewData() {
    try {
        const response = await fetch('/call-other-server');
        const json = await response.json();

        if (json.status === "success") {

            json.data.forEach(entry => {
                // Brug timestamp som unik nøgle (eller en log-ID hvis du har én)
                const key = entry.timestamp + entry.ip + entry.method + entry.url + entry.country;

                // Spring over hvis vi allerede har tilføjet den
                if (!seenEntries.has(key)) {
                    seenEntries.add(key);
                    insertRow(entry);
                }
            });
        }

    } catch (err) {
        console.error("Kunne ikke hente data:", err);
    }
}

// Hent data hvert minut
setInterval(fetchNewData, 60000);

// Hent første gang med det samme
fetchNewData();




document.getElementById('sætRateLimit_ID').addEventListener('click', () => {
    const rate = document.getElementById('rateLimit_ID').value;

    fetch('/set-rate-limit', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({ rate: parseInt(rate) }) // sender rate som JSON
    })
    .then(response => {
        if (!response.ok) throw new Error('Fejl ved opdatering');
        return response.json();
    })
    .then(data => {
        alert('Rate limit opdateret: ' + data.rate);
    })
    .catch(err => {
        console.error(err);
        alert('Noget gik galt');
    });
});

</script>


